#!/usr/bin/env python3
"""Bundle checked-in catalogs; no network or original checkout required."""
import json
from pathlib import Path
root = Path(__file__).resolve().parent.parent
catalogs = {}
for code in ('en', 'de', 'fr', 'es', 'it', 'pt', 'nl', 'pl'):
    base = root / 'translations'
    catalogs[code] = json.loads((base / f'{code}.json').read_text())
    catalogs[code].update(json.loads((base / 'extra' / f'{code}.json').read_text()))
(root / 'translations/bundled.json').write_text(json.dumps(catalogs, ensure_ascii=False, indent=2) + '\n')
